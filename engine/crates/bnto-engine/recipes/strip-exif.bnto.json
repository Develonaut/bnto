{
  "id": "strip-exif",
  "type": "group",
  "version": "1.0.0",
  "name": "Strip EXIF",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Remove EXIF metadata from images instantly in your browser. No upload limits, no signup.",
    "category": "image",
    "tags": ["PNG", "JPEG", "WebP", "No upload", "Browser-based"]
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "accept": ["image/jpeg", "image/png", "image/webp"],
        "extensions": [".jpg", ".jpeg", ".png", ".webp"],
        "label": "JPEG, PNG, or WebP images",
        "multiple": true
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "strip-exif-node",
      "type": "image-strip-exif",
      "version": "1.0.0",
      "name": "Strip EXIF",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "quality": 80
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "download",
        "directory": "{{ctx.paths.output_dir}}/{{ctx.date}}-strip-exif",
        "label": "Cleaned Images",
        "zip": true,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "strip-exif-node"
    },
    {
      "id": "e2",
      "source": "strip-exif-node",
      "target": "output"
    }
  ]
}
