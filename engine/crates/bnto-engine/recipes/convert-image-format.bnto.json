{
  "id": "convert-image-format",
  "type": "group",
  "version": "1.0.0",
  "name": "Convert Image Format",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Convert between PNG, JPEG, WebP, and GIF formats instantly. Free, no signup.",
    "category": "image",
    "tags": ["PNG", "JPEG", "WebP", "GIF", "Browser-based"]
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "accept": ["image/jpeg", "image/png", "image/webp", "image/gif"],
        "extensions": [".jpg", ".jpeg", ".png", ".webp", ".gif"],
        "label": "JPEG, PNG, WebP, or GIF images",
        "multiple": true
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "convert-image",
      "type": "image-convert",
      "version": "1.0.0",
      "name": "Convert",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "format": "webp",
        "quality": 80
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "write",
        "directory": "{{ctx.paths.output_dir}}/{{ctx.date}}-convert-image-format",
        "label": "Converted Images",
        "zip": true,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "convert-image"
    },
    {
      "id": "e2",
      "source": "convert-image",
      "target": "output"
    }
  ]
}
