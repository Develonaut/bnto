{
  "id": "flatten-folders",
  "type": "group",
  "version": "1.0.0",
  "name": "Flatten Folders",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Collect all files from nested subdirectories into a single flat output folder. CLI/desktop only.",
    "category": "file",
    "tags": ["Organize", "Flatten", "Folders", "Cleanup"]
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "explicit"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Source Directory",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "accept": ["*/*"],
        "extensions": [],
        "label": "directory to flatten",
        "multiple": false
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "directory"
        }
      ]
    },
    {
      "id": "collect",
      "type": "file-collect",
      "version": "1.0.0",
      "name": "Collect All Files",
      "position": {
        "x": 200,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "pattern": "*",
        "recursive": true,
        "flatten": true
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Flattened Files",
      "position": {
        "x": 400,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "write",
        "directory": "{{ctx.paths.output_dir}}/{{ctx.date}}-flatten-folders",
        "label": "Flattened Files",
        "zip": false,
        "autoDownload": false
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "collect"
    },
    {
      "id": "e2",
      "source": "collect",
      "target": "output"
    }
  ]
}
