{
  "id": "bulk-video-download",
  "type": "group",
  "version": "1.0.0",
  "name": "Bulk Video Download",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Download and organize videos from a CSV manifest. Each row provides a URL and optional group folder. Requires yt-dlp and ffmpeg. CLI/desktop only.",
    "category": "video",
    "tags": ["CSV manifest", "Bulk download", "yt-dlp", "Video organization"]
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "explicit"
  },
  "requires": [
    {
      "binary": "yt-dlp",
      "installHint": "brew install yt-dlp",
      "homepage": "https://github.com/yt-dlp/yt-dlp"
    },
    {
      "binary": "ffmpeg",
      "installHint": "brew install ffmpeg",
      "homepage": "https://ffmpeg.org"
    }
  ],
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "CSV Manifest",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "accept": ["text/csv"],
        "extensions": [".csv"],
        "label": "Video Manifest CSV",
        "multiple": false,
        "placeholder": "manifest.csv (columns: group, url)"
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "read-csv",
      "type": "spreadsheet-read",
      "version": "1.0.0",
      "name": "Read CSV Rows",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "hasHeaders": true,
        "delimiter": "comma",
        "maxRows": 100000
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "loop",
      "type": "loop",
      "version": "1.0.0",
      "name": "Per Row",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "forEach"
      },
      "inputPorts": [],
      "outputPorts": [],
      "nodes": [
        {
          "id": "download",
          "type": "shell-command",
          "version": "1.0.0",
          "name": "Download Video",
          "position": {
            "x": 0,
            "y": 0
          },
          "metadata": {},
          "parameters": {
            "command": "yt-dlp",
            "args": [
              "--no-playlist",
              "--no-warnings",
              "--newline",
              "--merge-output-format",
              "mp4",
              "-o",
              "{{output_dir}}/{{item.group}}/%(title)s.%(ext)s",
              "{{item.url}}"
            ],
            "outputMode": "file",
            "maxOutputSize": 2048
          },
          "inputPorts": [],
          "outputPorts": []
        }
      ],
      "edges": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 750,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "download",
        "label": "Downloaded Videos",
        "zip": true,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "read-csv"
    },
    {
      "id": "e2",
      "source": "read-csv",
      "target": "loop"
    },
    {
      "id": "e3",
      "source": "loop",
      "target": "output"
    }
  ]
}
