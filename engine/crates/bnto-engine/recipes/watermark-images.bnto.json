{
  "id": "watermark-images",
  "type": "group",
  "version": "1.0.0",
  "name": "Watermark Images",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Add a logo or watermark to images. Position, size, and opacity are fully configurable. Runs in your browser \u2014 files never leave your machine.",
    "category": "image",
    "tags": ["PNG", "JPEG", "WebP", "Configurable position", "Adjustable opacity", "Browser-based"]
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "accept": ["image/jpeg", "image/png", "image/webp"],
        "extensions": [".jpg", ".jpeg", ".png", ".webp"],
        "label": "JPEG, PNG, or WebP images",
        "multiple": true
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "overlay",
      "type": "image-overlay",
      "version": "1.0.0",
      "name": "Overlay",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "position": "bottom-right",
        "size": 25,
        "opacity": 80,
        "offsetX": 0,
        "offsetY": 0,
        "quality": 80,
        "overlay": ""
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "write",
        "directory": "{{ctx.paths.output_dir}}/{{ctx.date}}-watermark-images",
        "label": "Watermarked Images",
        "zip": true,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "overlay"
    },
    {
      "id": "e2",
      "source": "overlay",
      "target": "output"
    }
  ]
}
