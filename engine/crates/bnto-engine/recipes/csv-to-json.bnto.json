{
  "id": "csv-to-json",
  "type": "group",
  "version": "1.0.0",
  "name": "CSV to JSON",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Convert CSV files to JSON format with configurable delimiters. Free, no signup.",
    "category": "spreadsheet",
    "tags": ["CSV", "JSON", "Configurable delimiter", "Browser-based"]
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "accept": ["text/csv"],
        "extensions": [".csv"],
        "label": "CSV files",
        "multiple": false
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "convert",
      "type": "spreadsheet-convert",
      "version": "1.0.0",
      "name": "Convert to JSON",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "delimiter": "comma",
        "pretty": false
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "download",
        "directory": "{{ctx.paths.output_dir}}/{{ctx.date}}-csv-to-json",
        "label": "JSON file",
        "zip": false,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "convert"
    },
    {
      "id": "e2",
      "source": "convert",
      "target": "output"
    }
  ]
}
