{
  "id": "download-video",
  "type": "group",
  "version": "1.0.0",
  "name": "Download Video",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Download video or audio from URLs using yt-dlp. Supports YouTube, m3u8/HLS streams, and hundreds of sites. CLI/desktop only.",
    "category": "video",
    "tags": ["YouTube", "m3u8/HLS", "MP4/WebM/MKV", "Audio extraction"]
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "requires": [
    {
      "binary": "yt-dlp",
      "installHint": "brew install yt-dlp",
      "homepage": "https://github.com/yt-dlp/yt-dlp"
    },
    {
      "binary": "ffmpeg",
      "installHint": "brew install ffmpeg",
      "homepage": "https://ffmpeg.org"
    }
  ],
  "fields": {
    "format": {
      "type": "enum",
      "label": "Output Format",
      "description": "Video container format",
      "options": [
        { "value": "mp4", "label": "MP4 (H.264)" },
        { "value": "webm", "label": "WebM (VP9)" },
        { "value": "mkv", "label": "MKV (Matroska)" }
      ],
      "default": "mp4",
      "order": 1
    },
    "videoCodec": {
      "type": "enum",
      "label": "Video Codec",
      "options": [
        { "value": "h264", "label": "H.264" },
        { "value": "vp9", "label": "VP9" },
        { "value": "av1", "label": "AV1" }
      ],
      "default": "h264",
      "order": 2
    },
    "audioCodec": {
      "type": "enum",
      "label": "Audio Codec",
      "options": [
        { "value": "m4a", "label": "M4A (AAC)" },
        { "value": "opus", "label": "Opus" },
        { "value": "mp3", "label": "MP3" }
      ],
      "default": "m4a",
      "order": 3
    }
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "url",
        "accept": [],
        "extensions": [],
        "label": "Video URL",
        "multiple": true,
        "placeholder": "https://youtube.com/watch?v=..."
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "download",
      "type": "shell-command",
      "version": "1.0.0",
      "name": "Download Video",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "command": "yt-dlp",
        "args": [
          "--no-playlist",
          "--no-warnings",
          "--merge-output-format",
          "{fields.format}",
          "-S",
          "vcodec:{fields.videoCodec},acodec:{fields.audioCodec}",
          "-o",
          "{output_dir}/%(title)s.%(ext)s"
        ],
        "outputMode": "file"
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "download",
        "label": "Downloaded Video",
        "zip": true,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "download"
    },
    {
      "id": "e2",
      "source": "download",
      "target": "output"
    }
  ]
}
