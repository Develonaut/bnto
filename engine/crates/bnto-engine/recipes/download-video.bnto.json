{
  "id": "download-video",
  "type": "group",
  "version": "1.0.0",
  "name": "Download Video",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Download video or audio from URLs using yt-dlp. Supports YouTube, m3u8/HLS streams, and hundreds of sites. CLI/desktop only.",
    "category": "video",
    "tags": ["YouTube", "m3u8/HLS", "MP4/WebM/MKV", "Audio extraction"]
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "requires": [
    {
      "binary": "yt-dlp",
      "installHint": "brew install yt-dlp",
      "homepage": "https://github.com/yt-dlp/yt-dlp"
    },
    {
      "binary": "ffmpeg",
      "installHint": "brew install ffmpeg",
      "homepage": "https://ffmpeg.org"
    }
  ],
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "url",
        "accept": [],
        "extensions": [],
        "label": "Video URL",
        "multiple": true,
        "placeholder": "https://youtube.com/watch?v=..."
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "download",
      "type": "shell-command",
      "version": "1.0.0",
      "name": "Download Video",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "command": "yt-dlp",
        "args": [
          "--no-playlist",
          "--no-warnings",
          "--newline",
          "--merge-output-format",
          "{{fields.format}}",
          "-S",
          "vcodec:{{fields.videoCodec}},acodec:{{fields.audioCodec}}",
          ["--cookies-from-browser", "{{fields.browser}}"],
          ["--write-subs", "--embed-subs", "--sub-langs", "{{fields.subtitles}}"],
          ["-S", "res:{{fields.quality}}"],
          "{{fields.thumbnail}}",
          "{{fields.sponsorBlock}}",
          "-o",
          "{{output_dir}}/%(title)s.%(ext)s"
        ],
        "outputMode": "file",
        "maxOutputSize": 2048
      },
      "fields": {
        "format": {
          "type": "enum",
          "label": "Output Format",
          "description": "Video container format",
          "options": [
            { "value": "mp4", "label": "MP4 (H.264)" },
            { "value": "webm", "label": "WebM (VP9)" },
            { "value": "mkv", "label": "MKV (Matroska)" }
          ],
          "default": "mp4",
          "order": 1
        },
        "videoCodec": {
          "type": "enum",
          "label": "Video Codec",
          "options": [
            { "value": "h264", "label": "H.264" },
            { "value": "vp9", "label": "VP9" },
            { "value": "av1", "label": "AV1" }
          ],
          "default": "h264",
          "order": 2
        },
        "audioCodec": {
          "type": "enum",
          "label": "Audio Codec",
          "options": [
            { "value": "m4a", "label": "M4A (AAC)" },
            { "value": "opus", "label": "Opus" },
            { "value": "mp3", "label": "MP3" }
          ],
          "default": "m4a",
          "order": 3
        },
        "browser": {
          "type": "enum",
          "label": "Browser Cookies",
          "description": "Use cookies from a browser for authenticated content (Patreon, private videos)",
          "options": [
            { "value": "", "label": "None" },
            { "value": "chrome", "label": "Chrome" },
            { "value": "firefox", "label": "Firefox" },
            { "value": "safari", "label": "Safari" }
          ],
          "default": "",
          "order": 4
        },
        "quality": {
          "type": "enum",
          "label": "Quality Cap",
          "description": "Maximum video resolution (best available if unset)",
          "options": [
            { "value": "", "label": "Best available" },
            { "value": "1080", "label": "1080p" },
            { "value": "720", "label": "720p" },
            { "value": "480", "label": "480p" }
          ],
          "default": "",
          "order": 5
        },
        "subtitles": {
          "type": "enum",
          "label": "Subtitles",
          "description": "Download and embed subtitles in the selected language",
          "options": [
            { "value": "", "label": "None" },
            { "value": "en", "label": "English" },
            { "value": "all", "label": "All languages" },
            { "value": "en,es,fr,de,ja", "label": "Common (EN/ES/FR/DE/JA)" }
          ],
          "default": "",
          "order": 6
        },
        "thumbnail": {
          "type": "enum",
          "label": "Embed Thumbnail",
          "description": "Embed the video thumbnail in the output file",
          "options": [
            { "value": "", "label": "No" },
            { "value": "--embed-thumbnail", "label": "Yes" }
          ],
          "default": "",
          "order": 7
        },
        "sponsorBlock": {
          "type": "enum",
          "label": "SponsorBlock",
          "description": "Remove sponsor segments from YouTube videos",
          "options": [
            { "value": "", "label": "Keep all" },
            { "value": "--sponsorblock-remove=default", "label": "Remove sponsors" }
          ],
          "default": "",
          "order": 8
        }
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "download",
        "label": "Downloaded Video",
        "zip": true,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "download"
    },
    {
      "id": "e2",
      "source": "download",
      "target": "output"
    }
  ]
}
