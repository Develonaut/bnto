{
  "id": "check-folders-one",
  "type": "group",
  "version": "1.0.0",
  "name": "Check Folders One",
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "parameters": { "mode": "file-upload", "multiple": true }
    },
    {
      "id": "keep-docs",
      "type": "file-filter",
      "parameters": { "namePattern": "*.md" }
    },
    {
      "id": "output",
      "type": "output",
      "parameters": { "mode": "none" }
    }
  ]
}
