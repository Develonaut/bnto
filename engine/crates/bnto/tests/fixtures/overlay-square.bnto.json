{
  "id": "overlay-square",
  "type": "group",
  "version": "1.0.0",
  "name": "Full-Size Overlay (Square)",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Full-size overlay composited onto source image."
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "accept": ["image/jpeg", "image/png", "image/webp"],
        "extensions": [".jpg", ".jpeg", ".png", ".webp"],
        "label": "JPEG, PNG, or WebP images",
        "multiple": true
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "overlay",
      "type": "image-overlay",
      "version": "1.0.0",
      "name": "Overlay",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "position": "center",
        "size": 100,
        "opacity": 50,
        "offsetX": 0,
        "offsetY": 0,
        "quality": 80,
        "overlay": "data:image/png;base64,"
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "write",
        "label": "Overlaid Images",
        "zip": true,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "overlay"
    },
    {
      "id": "e2",
      "source": "overlay",
      "target": "output"
    }
  ]
}
