{
  "id": "file-rename-overwrite",
  "type": "group",
  "version": "1.0.0",
  "name": "File Rename Overwrite",
  "position": { "x": 0, "y": 0 },
  "metadata": {
    "description": "Collects a directory's files and renames them in place by a pattern. The pattern is set with a param override."
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": { "iteration": "auto" },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": { "x": 0, "y": 100 },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "multiple": true
      },
      "inputPorts": [],
      "outputPorts": [{ "id": "out-1", "name": "files" }]
    },
    {
      "id": "collect",
      "type": "file-collect",
      "version": "1.0.0",
      "name": "Collect",
      "position": { "x": 125, "y": 100 },
      "metadata": {},
      "parameters": {
        "flatten": false
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "rename",
      "type": "file-rename",
      "version": "1.0.0",
      "name": "Rename",
      "position": { "x": 250, "y": 100 },
      "metadata": {},
      "parameters": {
        "pattern": "{{name}}.{{ext}}"
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": { "x": 500, "y": 100 },
      "metadata": {},
      "parameters": {
        "mode": "overwrite"
      },
      "inputPorts": [{ "id": "in-1", "name": "files" }],
      "outputPorts": []
    }
  ],
  "edges": [
    { "id": "e1", "source": "input", "target": "collect" },
    { "id": "e1b", "source": "collect", "target": "rename" },
    { "id": "e2", "source": "rename", "target": "output" }
  ]
}
