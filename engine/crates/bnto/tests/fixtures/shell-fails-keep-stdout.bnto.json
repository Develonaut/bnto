{
  "id": "shell-fails-keep-stdout",
  "type": "group",
  "version": "1.0.0",
  "name": "Shell Fails Keep Stdout",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Diffs two files with `git diff --no-index`, which exits 1 when they differ, then a closing file-copy keeps the diff it printed even though the run fails."
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "none"
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "diff",
      "type": "shell-run",
      "version": "1.0.0",
      "name": "Diff",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "command": "git",
        "args": ["-c", "core.autocrlf=false", "diff", "--no-index", "before.txt", "after.txt"],
        "outputMode": "stdout"
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "publish",
      "type": "file-copy",
      "version": "1.0.0",
      "name": "Publish",
      "position": {
        "x": 375,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "destination": "."
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "keep",
      "type": "file-copy",
      "version": "1.0.0",
      "name": "Keep Diff",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "destination": "."
      },
      "inputPorts": [],
      "outputPorts": [],
      "always": true
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 750,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "write"
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "diff"
    },
    {
      "id": "e2",
      "source": "diff",
      "target": "publish"
    },
    {
      "id": "e3",
      "source": "publish",
      "target": "keep"
    },
    {
      "id": "e4",
      "source": "keep",
      "target": "output"
    }
  ]
}
