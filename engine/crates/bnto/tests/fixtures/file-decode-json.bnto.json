{
  "id": "file-decode-json",
  "type": "group",
  "version": "1.0.0",
  "name": "File Decode JSON",
  "position": { "x": 0, "y": 0 },
  "metadata": {
    "description": "Decodes a base64 file into JSON, reads its array, and names each element's item by its name and nested meta.size fields."
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": { "iteration": "auto" },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": { "x": 0, "y": 100 },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "multiple": true
      },
      "inputPorts": [],
      "outputPorts": [{ "id": "out-1", "name": "files" }]
    },
    {
      "id": "decode",
      "type": "file-decode",
      "version": "1.0.0",
      "name": "Decode",
      "position": { "x": 125, "y": 100 },
      "metadata": {},
      "parameters": {
        "encoding": "base64",
        "filename": "{{name}}.json"
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "read",
      "type": "spreadsheet-read",
      "version": "1.0.0",
      "name": "Read",
      "position": { "x": 250, "y": 100 },
      "metadata": {},
      "parameters": {},
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "rename",
      "type": "file-rename",
      "version": "1.0.0",
      "name": "Rename",
      "position": { "x": 375, "y": 100 },
      "metadata": {},
      "parameters": {
        "pattern": "{{item.name}}-{{item.meta.size}}.txt"
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": { "x": 500, "y": 100 },
      "metadata": {},
      "parameters": {
        "mode": "message"
      },
      "inputPorts": [{ "id": "in-1", "name": "files" }],
      "outputPorts": []
    }
  ],
  "edges": [
    { "id": "e1", "source": "input", "target": "decode" },
    { "id": "e2", "source": "decode", "target": "read" },
    { "id": "e3", "source": "read", "target": "rename" },
    { "id": "e4", "source": "rename", "target": "output" }
  ]
}
