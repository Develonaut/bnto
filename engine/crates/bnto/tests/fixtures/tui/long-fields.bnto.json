{
  "id": "long-fields",
  "type": "group",
  "version": "1.0.0",
  "name": "Long Fields",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "A shell recipe with five declared fields whose descriptions wrap, for TUI journey TJ11.",
    "category": "system"
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "No Input",
      "position": {
        "x": 0,
        "y": 0
      },
      "metadata": {},
      "parameters": {
        "mode": "none"
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "talk",
      "type": "shell-run",
      "version": "1.0.0",
      "name": "Talk",
      "position": {
        "x": 250,
        "y": 0
      },
      "metadata": {},
      "parameters": {
        "shell": "sh",
        "script": "echo \"$@\"",
        "outputMode": "stdout",
        "timeout": 30,
        "args": [
          "{{fields.source}}",
          "{{fields.target}}",
          "{{fields.format}}",
          "{{fields.retries}}",
          "{{fields.verbose}}"
        ]
      },
      "inputPorts": [],
      "outputPorts": [],
      "fields": {
        "source": {
          "type": "string",
          "label": "Source",
          "description": "This description is long on purpose so it wraps across several rows on a narrow terminal and pushes later fields below the fold.",
          "default": "a",
          "order": 1
        },
        "target": {
          "type": "string",
          "label": "Target",
          "description": "This description is long on purpose so it wraps across several rows on a narrow terminal and pushes later fields below the fold.",
          "default": "b",
          "order": 2
        },
        "format": {
          "type": "enum",
          "label": "Format",
          "description": "This description is long on purpose so it wraps across several rows on a narrow terminal and pushes later fields below the fold.",
          "options": [
            {
              "value": "mp4",
              "label": "MP4"
            },
            {
              "value": "webm",
              "label": "WebM"
            }
          ],
          "default": "mp4",
          "order": 3
        },
        "retries": {
          "type": "number",
          "label": "Retries",
          "description": "This description is long on purpose so it wraps across several rows on a narrow terminal and pushes later fields below the fold.",
          "default": 1,
          "order": 4
        },
        "verbose": {
          "type": "boolean",
          "label": "Verbose",
          "description": "This description is long on purpose so it wraps across several rows on a narrow terminal and pushes later fields below the fold.",
          "default": false,
          "order": 5
        }
      }
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Log",
      "position": {
        "x": 500,
        "y": 0
      },
      "metadata": {},
      "parameters": {
        "mode": "message",
        "label": "Log"
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "talk"
    },
    {
      "id": "e2",
      "source": "talk",
      "target": "output"
    }
  ]
}
