{
  "id": "watermark-images",
  "type": "group",
  "version": "1.0.0",
  "name": "Watermark Images",
  "position": {
    "x": 0,
    "y": 0
  },
  "metadata": {
    "description": "Accepts image files and overlays a watermark onto each one."
  },
  "parameters": {},
  "inputPorts": [],
  "outputPorts": [],
  "settings": {
    "iteration": "auto"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "version": "1.0.0",
      "name": "Input",
      "position": {
        "x": 0,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "file-upload",
        "accept": ["image/jpeg", "image/png", "image/webp"],
        "extensions": [".jpg", ".jpeg", ".png", ".webp"],
        "label": "JPEG, PNG, or WebP images",
        "multiple": true
      },
      "inputPorts": [],
      "outputPorts": [
        {
          "id": "out-1",
          "name": "files"
        }
      ]
    },
    {
      "id": "watermark-image",
      "type": "image-watermark",
      "version": "1.0.0",
      "name": "Watermark",
      "position": {
        "x": 250,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "position": "bottom-right",
        "size": 25,
        "opacity": 80,
        "offsetX": 10,
        "offsetY": 10,
        "quality": 80,
        "watermark": ""
      },
      "inputPorts": [],
      "outputPorts": []
    },
    {
      "id": "output",
      "type": "output",
      "version": "1.0.0",
      "name": "Output",
      "position": {
        "x": 500,
        "y": 100
      },
      "metadata": {},
      "parameters": {
        "mode": "download",
        "label": "Watermarked Images",
        "zip": true,
        "autoDownload": true
      },
      "inputPorts": [
        {
          "id": "in-1",
          "name": "files"
        }
      ],
      "outputPorts": []
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "watermark-image"
    },
    {
      "id": "e2",
      "source": "watermark-image",
      "target": "output"
    }
  ]
}
