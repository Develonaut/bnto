{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["lefthook", "tsx", "playwright", "convex"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": [
        "@auth/core",
        "@convex-dev/auth",
        "@eslint/js",
        "eslint-config-prettier",
        "eslint-plugin-check-file",
        "eslint-plugin-import-x",
        "typescript-eslint"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "app/**/not-found.tsx",
        "app/providers/**/*.{ts,tsx}",
        "e2e/**/*.ts"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@tailwindcss/typography",
        "@types/mdx",
        "@lhci/cli",
        "eslint-plugin-import"
      ]
    },
    "packages/core": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/editor": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/@bnto/form": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/@bnto/registry": {
      "project": ["src/**/*.ts"]
    },
    "packages/@bnto/auth": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["next", "react-dom"]
    },
    "packages/@bnto/backend": {
      "entry": ["convex/**/*.ts"],
      "project": ["convex/**/*.ts"]
    },
    "packages/@bnto/nodes": {
      "project": ["src/**/*.ts"],
      "ignore": ["src/generated/**"]
    }
  },
  "ignore": ["apps/desktop/**"]
}
