# Convex Cloud
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-app.vercel.app

# Debug — mirror execution events to browser console (dev only)
# NEXT_PUBLIC_DEBUG_LOGS=1

# Bento Grid Layout — enables new bento grid recipe view (dev only)
# NEXT_PUBLIC_BENTO_GRID=1
